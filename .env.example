# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored and must never be committed.

# Required — Groq API key from https://console.groq.com/keys (server-side only)
GROQ_API_KEY=PASTE_YOUR_NEW_GROQ_API_KEY_HERE

# Optional — port for the local/production server (Railway injects PORT automatically)
PORT=3000

# Optional — comma-separated origins allowed to call the API when the site is
# hosted somewhere other than this server (e.g. https://your-site.vercel.app).
# Local Live Server dev: http://127.0.0.1:5500,http://localhost:5500
ALLOWED_ORIGINS=

# Optional — model overrides (sensible defaults are built in)
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy

# Optional — speech engine: groq (server text-to-speech, default), browser
# (built-in Web Speech synthesis), silent (text only)
VOICE_TTS=groq
